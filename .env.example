# ============ LLM 配置（真实，必填） ============
# OpenAI 兼容端点。可替换为你自己的网关（DeepSeek / 通义 / vLLM / Ollama 等）。
LLM__PROVIDER=openai
LLM__BASE_URL=https://api.openai.com/v1
LLM__API_KEY=your-api-key-here
LLM__MODEL=gpt-4o-mini
LLM__TEMPERATURE=0.0
LLM__MAX_TOKENS=1024
LLM__TIMEOUT=30.0
# 若本机代理软件未运行、却残留 HTTP_PROXY/HTTPS_PROXY 环境变量，
# 会导致 LLM 调用报 "Connection error."，此时置 true 直连（不走环境代理）。
LLM__DISABLE_PROXY=false

# ============ 数据库配置（真实，必填） ============
# 生产建议用只读账户；敏感字段脱敏；审计日志开启。
DB__DIALECT=postgres
DB__DSN=postgresql://user:password@host:5432/dbname
# DB__DSN=postgresql://neondb_owner:***@ep-xxx-pooler.c-3.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
DB__DRY_RUN=true
DB__TIMEOUT=10.0
# 库级只读（强烈建议保持 true）：连接后 SET default_transaction_read_only = on。
# 与 sqlglot AST 白名单形成双保险——应用层被绕过时数据库仍拒绝写操作。
DB__READONLY=true
# 单条语句超时（毫秒）：防止慢查询占满连接与算力预算
DB__STATEMENT_TIMEOUT_MS=5000

# ============ 鉴权（FastAPI / MCP server 共用） ============
# 生产：注入固定高强度随机密钥（>=32 字节），并保持 DEV_TOKEN_ENDPOINT=false。
# 本地演示：随便填一个串 + 打开 DEV_TOKEN_ENDPOINT，就能用 /v1/auth/token 自助拿令牌。
AUTH__SECRET=change-me-to-a-random-32-bytes-secret
AUTH__ISSUER=nl2sql
AUTH__AUDIENCE=nl2sql-agent
AUTH__TTL_SECONDS=3600
AUTH__DEV_TOKEN_ENDPOINT=false

# ============ API 服务（限流 / 并发 / 会话） ============
# 每主体每分钟最大请求数（令牌桶）：防止调用方把 LLM 预算刷干
API__RATE_LIMIT_PER_MIN=60
# 同时打到 LLM/DB 的最大请求数（有界信号量）：保护下游，避免雪崩
API__MAX_CONCURRENCY=4
API__QUEUE_TIMEOUT=20.0
# 会话：TTL 过期 + 容量上限（超量按 LRU 淘汰），防止内存无限增长
API__SESSION_TTL_SECONDS=1800
API__MAX_SESSIONS=200

# ============ 检索 / 管道 ============
RETRIEVAL__MIN_SCORE=1.0
RETRIEVAL__TOP_K=5
PIPELINE__MAX_RETRY=1

# ============ 向量化 / 企业知识库（混合 RAG） ============
# embedding 默认**复用**上面的 LLM__BASE_URL / LLM__API_KEY（同一个网关）；
# 只有想单独指定时，才填 EMBEDDING__BASE_URL / EMBEDDING__API_KEY。
# EMBEDDING__BASE_URL=
# EMBEDDING__API_KEY=
EMBEDDING__MODEL=text-embedding-3-small
EMBEDDING__DIM=1536
# 默认继承 LLM__DISABLE_PROXY 的取值，一般不用单独设
# EMBEDDING__DISABLE_PROXY=false

KB__ENABLED=true
KB__TABLE=kb_docs
KB__TOP_K=4
KB__RRF_K=60
KB__DOC_MAX_CHARS=1200

# SQL 示例库的向量索引（长尾问句也能召回相近范例）
KB__EXAMPLE_TABLE=sql_example_vec
KB__EXAMPLE_TOP_K=4
KB__EXAMPLE_MIN_SIM=0.30

# rerank 精排（RRF 融合之后再排一次，并丢弃低分候选）
KB__RERANK=true
KB__RERANK_CANDIDATES=8
KB__RERANK_MIN_SCORE=3.0

# ============ 日志 ============
LOG__LEVEL=INFO
LOG__FMT=text
# LOG__FMT=json

# ============ LLM 配置（真实，必填） ============
# OpenAI 兼容端点。可替换为你自己的网关（DeepSeek / 通义 / vLLM / Ollama 等）。
LLM__PROVIDER=openai
LLM__BASE_URL=https://api.openai.com/v1
LLM__API_KEY=your-api-key-here
LLM__MODEL=gpt-4o-mini
LLM__TEMPERATURE=0.0
LLM__MAX_TOKENS=1024
LLM__TIMEOUT=30.0
# 若本机代理软件未运行、却残留 HTTP_PROXY/HTTPS_PROXY 环境变量，
# 会导致 LLM 调用报 "Connection error."，此时置 true 直连（不走环境代理）。
LLM__DISABLE_PROXY=false

# ============ 数据库配置（真实，必填） ============
# 生产建议用只读账户；敏感字段脱敏；审计日志开启。
DB__DIALECT=postgres
DB__DSN=postgresql://user:password@host:5432/dbname
# DB__DSN=postgresql://neondb_owner:***@ep-xxx-pooler.c-3.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
DB__DRY_RUN=true
DB__TIMEOUT=10.0

# ============ 检索 / 管道 ============
RETRIEVAL__MIN_SCORE=1.0
RETRIEVAL__TOP_K=5
PIPELINE__MAX_RETRY=1

# ============ 向量化 / 企业知识库（混合 RAG） ============
# embedding 默认**复用**上面的 LLM__BASE_URL / LLM__API_KEY（同一个网关）；
# 只有想单独指定时，才填 EMBEDDING__BASE_URL / EMBEDDING__API_KEY。
# EMBEDDING__BASE_URL=
# EMBEDDING__API_KEY=
EMBEDDING__MODEL=text-embedding-3-small
EMBEDDING__DIM=1536
# 默认继承 LLM__DISABLE_PROXY 的取值，一般不用单独设
# EMBEDDING__DISABLE_PROXY=false

KB__ENABLED=true
KB__TABLE=kb_docs
KB__TOP_K=4
KB__RRF_K=60
KB__DOC_MAX_CHARS=1200

# SQL 示例库的向量索引（长尾问句也能召回相近范例）
KB__EXAMPLE_TABLE=sql_example_vec
KB__EXAMPLE_TOP_K=4
KB__EXAMPLE_MIN_SIM=0.30

# rerank 精排（RRF 融合之后再排一次，并丢弃低分候选）
KB__RERANK=true
KB__RERANK_CANDIDATES=8
KB__RERANK_MIN_SCORE=3.0

# ============ 日志 ============
LOG__LEVEL=INFO
LOG__FMT=text
# LOG__FMT=json

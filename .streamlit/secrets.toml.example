# ============================================================
# Streamlit secrets 示例
#   本地开发：复制为 .streamlit/secrets.toml（该文件已被 .gitignore 忽略）
#   线上部署：Streamlit Cloud → 你的 App → Settings → Secrets，粘贴同样内容
# 键名与 .env 完全一致（pydantic-settings 用 __ 表示嵌套层级）
# ============================================================

# ---- LLM（OpenAI 兼容） ----
LLM__PROVIDER = "openai"
LLM__BASE_URL = "https://api.ephone.ai/v1"
LLM__API_KEY = "sk-在这里填你的key"
LLM__MODEL = "gpt-4o-mini"
LLM__TEMPERATURE = "0.0"
LLM__MAX_TOKENS = "1024"
LLM__TIMEOUT = "30.0"
# 本机代理未运行却残留代理环境变量时置 "true"（Cloud 上一般无需）
LLM__DISABLE_PROXY = "false"

# ---- 数据库（PostgreSQL / Neon） ----
DB__DIALECT = "postgres"
DB__DSN = "postgresql://user:password@host:5432/dbname?sslmode=require"
DB__DRY_RUN = "true"
DB__TIMEOUT = "10.0"

# ---- 检索 / 管道 / 日志 ----
RETRIEVAL__MIN_SCORE = "1.0"
RETRIEVAL__TOP_K = "5"
PIPELINE__MAX_RETRY = "1"
LOG__LEVEL = "INFO"
LOG__FMT = "text"

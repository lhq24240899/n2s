# ============================================================
# Streamlit secrets 示例
#   本地开发：复制为 .streamlit/secrets.toml（该文件已被 .gitignore 忽略）
#   线上部署：Streamlit Cloud → 你的 App → Settings → Secrets，粘贴同样内容
# 键名与 .env 完全一致（pydantic-settings 用 __ 表示嵌套层级）
# ============================================================

# ---- LLM（OpenAI 兼容） ----
LLM__PROVIDER = "openai"
LLM__BASE_URL = "https://api.ephone.ai/v1"
LLM__API_KEY = "sk-在这里填你的key"
LLM__MODEL = "gpt-4o-mini"
LLM__TEMPERATURE = "0.0"
LLM__MAX_TOKENS = "1024"
LLM__TIMEOUT = "30.0"
# 本机代理未运行却残留代理环境变量时置 "true"（Cloud 上一般无需）
LLM__DISABLE_PROXY = "false"

# ---- 数据库（PostgreSQL / Neon） ----
DB__DIALECT = "postgres"
DB__DSN = "postgresql://user:password@host:5432/dbname?sslmode=require"
DB__DRY_RUN = "true"
DB__TIMEOUT = "10.0"
# 库级只读 + 语句超时（生产务必保持 true）
DB__READONLY = "true"
DB__STATEMENT_TIMEOUT_MS = "5000"

# ---- 第二执行引擎：Elasticsearch（ES DSL 真执行，可选） ----
# 配好后网页侧边栏可切换「SQL / DSL / PPL」，三档分别打到真实引擎。
# 注意：阿里云 ES 公网入口是 http 明文，写 https 会 TLS 握手失败。
ES__ENABLED = "false"
ES__HOST = "http://es-cn-xxx.public.elasticsearch.aliyuncs.com:9200"
ES__USER = "elastic"
ES__PASSWORD = ""
ES__INDEX = "device_events"

# ---- 第三执行引擎：OpenSearch（PPL 真执行，可选） ----
# DSL 档打 ES__HOST；PPL 档打 ES__PPL_HOST。不配则 PPL 回退 ES__HOST 并降级为「仅编译」。
ES__PPL_ENABLED = "false"
ES__PPL_HOST = "https://<project>-<svc>.b.aivencloud.com:26380"
ES__PPL_USER = "avnadmin"
ES__PPL_PASSWORD = ""
# ES__PPL_INDEX = "device_events"    # 留空复用 ES__INDEX

# ---- 检索 / 管道 / 日志 ----
RETRIEVAL__MIN_SCORE = "1.0"
RETRIEVAL__TOP_K = "5"
PIPELINE__MAX_RETRY = "1"
LOG__LEVEL = "INFO"
LOG__FMT = "text"

# ---- 向量化 / 企业知识库（混合 RAG） ----
# embedding 默认复用上面的 LLM__BASE_URL / LLM__API_KEY，一般无需单独配
EMBEDDING__MODEL = "text-embedding-3-small"
EMBEDDING__DIM = "1536"
KB__ENABLED = "true"
KB__TOP_K = "4"
KB__RRF_K = "60"
# SQL 示例库向量索引 + rerank 精排
KB__EXAMPLE_TOP_K = "4"
KB__RERANK = "true"
KB__RERANK_CANDIDATES = "8"
KB__RERANK_MIN_SCORE = "3.0"
